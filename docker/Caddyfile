# Configuration interne du conteneur applicatif (FrankenPHP = Caddy + PHP).
#
# Depuis la mise en place du scaling horizontal, ce fichier ne sert plus que le
# PHP en interne, sur 8080, sans TLS. Les en-têtes de sécurité publics (V05) et
# les certificats sont portés par le conteneur « proxy »
# (docker/Caddyfile.proxy), seul point d'entrée du trafic externe.

{
	{$CADDY_GLOBAL_OPTIONS}
	frankenphp
	# Aucun certificat n'est demandé ici : ce serveur n'est jamais joint
	# directement depuis Internet.
	auto_https off
}

{$SERVER_NAME::8080} {
	root /app/public
	encode zstd br gzip

	# Nom du conteneur qui a traité la requête. C'est ce qui rend la
	# répartition de charge observable : scripts/demo-scaling.sh lit cet
	# en-tête pour montrer que les requêtes atterrissent sur des réplicas
	# différents.
	header X-Served-By {system.hostname}

	# Les fichiers téléversés ne sont jamais interprétés : seuls les fichiers
	# statiques sont servis depuis /uploads, et le PHP n'est exécuté que par
	# public/index.php via le routeur ci-dessous (V06, défense en profondeur).
	@uploads path /uploads/*
	header @uploads {
		Content-Disposition "inline"
		X-Content-Type-Options "nosniff"
		Cache-Control "public, max-age=86400"
	}

	# La sonde de santé ne doit pas polluer le journal d'accès.
	@health path /health
	log_skip @health

	php_server {
		index index.php
	}
}
