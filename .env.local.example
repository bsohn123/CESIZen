# Copier ce fichier vers .env.local (non versionné) et renseigner les valeurs.
#
#   cp .env.local.example .env.local
#   php -r "echo bin2hex(random_bytes(16)), PHP_EOL;"   # génère un APP_SECRET

APP_ENV=dev
APP_SECRET=

# Doit correspondre au service "database" de compose.yaml
DATABASE_URL="mysql://app:app@127.0.0.1:3306/cesizen?serverVersion=8.4.0&charset=utf8mb4"

# Mailpit (compose.override.yaml) : interface web sur http://localhost:8025
MAILER_DSN=smtp://localhost:1025
