# Analyse statique du code applicatif.
# Le niveau est relevé progressivement : chaque montée de niveau fait l'objet
# d'un ticket type:technique, plutôt qu'une dette figée dans un fichier
# d'exclusions que plus personne ne relit.
includes:
    - vendor/phpstan/phpstan-doctrine/extension.neon

parameters:
    level: 5
    paths:
        - src
    excludePaths:
        - src/Kernel.php
    treatPhpDocTypesAsCertain: false

    # Doctrine assigne les identifiants par réflexion au moment du persist :
    # sans cette déclaration, PHPStan croit que $id ne reçoit jamais d'entier.
    doctrine:
        objectManagerLoader: tests/object-manager.php
